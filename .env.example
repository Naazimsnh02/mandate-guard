# Airwallex sandbox (Account > Developer > API keys)
AIRWALLEX_CLIENT_ID=
AIRWALLEX_API_KEY=
AIRWALLEX_BASE_URL=https://api.sandbox.airwallex.com

# Claude
ANTHROPIC_API_KEY=

# Mandate signing key (generated locally on first run; never commit)
MANDATE_SIGNING_KEY_PATH=./data/keys/mandate-ed25519.jwk

# Payment gateway: "test" (Airi-compatible stub) or "airi" (real Airi CLI)
GATEWAY=test
# airi-cli is macOS/Linux only. On Windows run it in the docker/airi container:
#   docker build -t mandate-guard-airi docker/airi
#   docker run -d --name mandate-guard-airi -v airi-home:/root mandate-guard-airi
#   docker exec mandate-guard-airi airi-cli auth login   (then: airi-cli auth poll)
AIRI_EXEC_PREFIX=docker exec -i mandate-guard-airi
AIRI_PAYMENT_METHOD_ID=
AIRI_MERCHANT_COUNTRY=US
