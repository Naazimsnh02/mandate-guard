{
  "name": "mandate-guard",
  "version": "0.1.0",
  "private": true,
  "description": "Intent-bound checkout agent that asks again when terms change (Airwallex Agentic Banking Hackathon, Kit 09)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "merchant": "tsx --env-file-if-exists=.env src/merchant/drift-mart/server.ts",
    "dev": "tsx --env-file-if-exists=.env src/dev.ts",
    "smoke:browser": "tsx scripts/smoke-browser.ts"
  },
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@fastify/formbody": "^9.0.1",
    "fastify": "^5.12.8",
    "jose": "^6.2.15",
    "playwright": "^1.65.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
